diff --git a/Sources/PipelineKitPooling/DurationNanoseconds.swift b/Sources/PipelineKitPooling/DurationNanoseconds.swift
new file mode 100644
index 0000000..49e4568
--- /dev/null
+++ b/Sources/PipelineKitPooling/DurationNanoseconds.swift
@@ -0,0 +1,11 @@
+/// Converts a duration to whole nanoseconds, clamping to the UInt64 range.
+func durationNanosecondsClamped(_ duration: Duration) -> UInt64 {
+    guard duration > .zero else { return 0 }
+    let components = duration.components
+    let (whole, multiplyOverflow) = UInt64(components.seconds)
+        .multipliedReportingOverflow(by: 1_000_000_000)
+    guard !multiplyOverflow else { return .max }
+    let fraction = UInt64(components.attoseconds / 1_000_000_000)
+    let (result, addOverflow) = whole.addingReportingOverflow(fraction)
+    return addOverflow ? .max : result
+}
diff --git a/Tests/PipelineKitPoolingTests/DurationNanosecondsTests.swift b/Tests/PipelineKitPoolingTests/DurationNanosecondsTests.swift
new file mode 100644
index 0000000..8d36ace
--- /dev/null
+++ b/Tests/PipelineKitPoolingTests/DurationNanosecondsTests.swift
@@ -0,0 +1,31 @@
+import XCTest
+@testable import PipelineKitPooling
+
+final class DurationNanosecondsTests: XCTestCase {
+    func testDurationNanosecondsIncludesWholeSeconds() {
+        let cases: [(Duration, UInt64)] = [
+            (.milliseconds(250), 250_000_000),
+            (.seconds(1), 1_000_000_000),
+            (.milliseconds(1250), 1_250_000_000),
+            (Duration(secondsComponent: 1, attosecondsComponent: -250_000_000_000_000_000), 750_000_000),
+            (Duration(secondsComponent: 0, attosecondsComponent: 1_999_999_999), 1)
+        ]
+        for (duration, expected) in cases {
+            XCTAssertEqual(durationNanosecondsClamped(duration), expected)
+        }
+    }
+
+    func testDurationNanosecondsClampsBoundaries() {
+        let cases: [(Duration, UInt64)] = [
+            (.zero, 0),
+            (.milliseconds(-1), 0),
+            (Duration(secondsComponent: 18_446_744_073, attosecondsComponent: 709_551_614_999_999_999), UInt64.max - 1),
+            (Duration(secondsComponent: 18_446_744_073, attosecondsComponent: 709_551_615_999_999_999), UInt64.max),
+            (Duration(secondsComponent: 18_446_744_073, attosecondsComponent: 709_551_616_000_000_000), UInt64.max),
+            (.seconds(18_446_744_074), UInt64.max)
+        ]
+        for (duration, expected) in cases {
+            XCTAssertEqual(durationNanosecondsClamped(duration), expected)
+        }
+    }
+}
